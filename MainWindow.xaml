<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Launcher" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <!-- Color palette -->
        <Color x:Key="DarkBlue">#FF081B3A</Color>
        <Color x:Key="Navy">#FF0E2A5C</Color>
        <Color x:Key="RoyalBlue">#FF1651B8</Color>
        <Color x:Key="LightBlue">#FFAAD8FF</Color>
        <Color x:Key="Gold">#FFF7B62D</Color>
        <Color x:Key="DarkGold">#FFC88A11</Color>
        <Color x:Key="White">#FFF5F7FA</Color>

        <SolidColorBrush x:Key="WindowBackground" Color="{StaticResource DarkBlue}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource RoyalBlue}" />
        <SolidColorBrush x:Key="AccentLight" Color="{StaticResource LightBlue}" />
        <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource Gold}" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource White}" />
    </Window.Resources>

    <Grid>
        <!-- Splash screen -->
        <Grid x:Name="SplashGrid">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource DarkBlue}" Offset="0" />
                    <GradientStop Color="{StaticResource Navy}" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image x:Name="LogoImage" Width="360" Height="360" Opacity="0" Stretch="Uniform" />
                <TextBlock x:Name="StartText" Text="Press anything to start" Foreground="{StaticResource TextBrush}"
                           FontSize="20" HorizontalAlignment="Center" Opacity="0" />
            </StackPanel>
        </Grid>

        <!-- Loading screen (hidden initially) -->
        <Grid x:Name="LoadingGrid" Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource Navy}" Offset="0" />
                    <GradientStop Color="{StaticResource RoyalBlue}" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="600">
                <TextBlock Text="Loading..." Foreground="{StaticResource TextBrush}" FontSize="28" HorizontalAlignment="Center" />
                <ProgressBar x:Name="ProgressBar" Height="24" Minimum="0" Maximum="100" Value="0" />
                <TextBlock x:Name="ProgressText" Text="0%" Foreground="{StaticResource TextBrush}" FontSize="14" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Character selection screen -->
        <Grid x:Name="CharacterGrid" Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource RoyalBlue}" Offset="0" />
                    <GradientStop Color="{StaticResource LightBlue}" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- small logo in corner -->
            <Image x:Name="SmallLogo" Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" />

            <StackPanel Margin="40" VerticalAlignment="Center" HorizontalAlignment="Center" Width="640">
                <TextBlock Text="Select your character" Foreground="{StaticResource TextBrush}" FontSize="28" />
                <Border Background="#201651B8" Padding="12" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="Character Sheet 1" Foreground="{StaticResource TextBrush}" FontSize="20" />
                        <TextBlock Text="Character Sheet 2" Foreground="{StaticResource TextBrush}" FontSize="20" Margin="0,6,0,0" />
                        <TextBlock Text="Character Sheet 3" Foreground="{StaticResource TextBrush}" FontSize="20" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
